# Supabase (público — nunca colocar service role aqui)
# Copiar para .env.local e preencher. Não fazer commit de .env / .env.local.

# URL do projeto Supabase (Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=

# Chave anónima / publishable (Settings → API → anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
